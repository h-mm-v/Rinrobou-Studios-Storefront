HOST=your-lightsail-endpoint.amazonaws.com
DB_PORT=3306
USER=your-database-user
PASSWORD=your-database-password
DATABASE=your-database-name

# Public origin for payment provider return URLs.
PUBLIC_BASE_URL=http://localhost:3000

# Use Stripe test keys while testing.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Test defaults only. Configure the correct amounts before enabling live checkout.
SALES_TAX_RATE_PERCENT=5
SHIPPING_FEE_CENTS=500
ENABLE_LIVE_PAYMENTS=false
LIVE_PRICING_CONFIRMED=false
